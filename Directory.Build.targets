<Project>
  <Target Name="Compile Sass"
          BeforeTargets="Build;ResolveScopedCssInputs;ResolveProjectStaticWebAssets"
          Condition="Exists('$(SassCompilerTasksAssembly)') And '$(DesignTimeBuild)' != 'true'">
    <CompileSass AppsettingsFile="$(SassCompilerAppsettingsJson)"
                 SassCompilerFile="$(SassCompilerSassCompilerJson)"
                 Command="$(SassCompilerBuildCommand)"
                 Snapshot="$(SassCompilerBuildSnapshot)"
                 Configuration="$(SassCompilerConfiguration)"
                 TargetFramework="$(TargetFramework)"
                 TargetFrameworks="$(TargetFrameworks)">
      <Output TaskParameter="GeneratedFiles" ItemName="CompiledCssFiles" />
    </CompileSass>
    <ItemGroup>
      <None Remove="@(CompiledCssFiles)" />
      <_NewCompiledCssFiles Include="@(CompiledCssFiles)" Exclude="@(Content)" />
      <Content Include="@(_NewCompiledCssFiles)" />
    </ItemGroup>
  </Target>

  <!--
    Microsoft.Web.LibraryManager.Build restores in every project's own Build, but its shared download cache has no
    cross-process locking, so concurrent restores in a parallel solution build collide (IOException / LIB003). Turn
    the package's own restore off in the real build and run it through eng/LibraryManagerRestore.proj instead, which
    MSBuild builds once and every project waits on, serializing the restores. The one instance that runs it
    (LibmanSerialized=true) keeps the package's restore on. Opt out entirely with -p:LibraryRestore=False.
  -->
  <PropertyGroup>
    <_LibmanRestoreRequested Condition="'$(LibraryRestore)' != 'False'">true</_LibmanRestoreRequested>
    <LibraryRestore Condition="'$(LibmanSerialized)' != 'true'">False</LibraryRestore>
  </PropertyGroup>

  <Target Name="SerializedLibraryManagerRestore"
          Condition="'$(LibmanSerialized)' != 'true' And '$(_LibmanRestoreRequested)' == 'true' And '$(BuildingForLiveUnitTesting)' != 'true' And Exists('$(MSBuildProjectDirectory)/libman.json')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)eng/LibraryManagerRestore.proj" Targets="RestoreLibraries" />
  </Target>

  <!-- app.scss imports Vendor/bootstrap, which exists only after libman restore; make the order explicit. -->
  <Target Name="EnsureLibraryManagerRestoreBeforeSassCompile"
          BeforeTargets="Compile Sass"
          DependsOnTargets="SerializedLibraryManagerRestore"
          Condition="Exists('$(MSBuildProjectDirectory)/libman.json')" />

  <!--
    Static web assets are discovered from Content items, whose wwwroot globs are expanded when the project is
    evaluated, before libman restores wwwroot/fonts on a clean checkout. Files restored later are then absent from
    the static web assets manifest and endpoints manifest, so MapStaticAssets answers 404 for them in a published
    image. Add what libman wrote under wwwroot/fonts (its only wwwroot destination) to Content right after the restore, with project-relative paths (DefineStaticWebAssets
    rejects absolute ones against its wwwroot/** pattern), so every later static web assets target sees it.
  -->
  <Target Name="IncludeLibraryManagerWwwrootAssets"
          AfterTargets="SerializedLibraryManagerRestore"
          Condition="Exists('$(MSBuildProjectDirectory)/libman.json') And '$(DesignTimeBuild)' != 'true' And '$(LibmanSerialized)' != 'true'">
    <ItemGroup>
      <_LibmanWwwrootFiles Include="wwwroot/fonts/**" Exclude="@(Content)" />
      <None Remove="@(_LibmanWwwrootFiles)" />
      <Content Include="@(_LibmanWwwrootFiles)" />
    </ItemGroup>
  </Target>
</Project>
