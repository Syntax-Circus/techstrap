{
  "ConnectionStrings": {
    "TechStrap": ""
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseStartTls": true,
      "DefaultFrom": "",
      "MaxRetryAttempts": 3,
      "TlsMode": "",
      "RetryMode": "Legacy",
      "TotalSendTimeout": ""
    }
  },
  "EmailOutbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "LeaseSeconds": 900,
