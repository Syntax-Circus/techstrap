<Project Sdk="Microsoft.NET.Sdk">

  <!-- Public NuGet package: device and app metadata plus a submit helper for MAUI apps. Plain net10.0 on purpose (D-048): every platform value is read through an injected MAUI Essentials interface, so no workload or platform TFM is needed. Never set UseMaui. -->

  <Import Project="../../eng/Packaging.props" />

  <PropertyGroup>
    <PackageId>TechStrap.Client.Maui</PackageId>
    <Description>Device and app metadata capture and a submit-ticket helper for MAUI apps, on top of TechStrap.Client.</Description>
    <PackageTags>techstrap;helpdesk;sdk;maui</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TechStrap.Client/TechStrap.Client.csproj" />
    <ProjectReference Include="../TechStrap.Contracts/TechStrap.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechStrap.Client.Maui.Tests" />
  </ItemGroup>

</Project>