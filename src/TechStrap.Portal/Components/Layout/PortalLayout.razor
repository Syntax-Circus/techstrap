@inherits LayoutComponentBase

<AccentScope Accent="@Theme?.Accent">
    <div class="ts-portal">
        @if (Theme is { } header)
        {
            <ProductHeader Theme="header" />
        }
        <main class="ts-portal-main">@Body</main>
        @if (Theme is { } footer)
        {
            <ProductFooter Theme="footer" />
        }
        <PoweredByFooter />
    </div>
</AccentScope>
