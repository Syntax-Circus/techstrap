@attribute [Route(PortalRoutes.FeatureTemplate)]
@inherits ProductPageBase
@using TechStrap.Portal.Features

@if (UnavailableMessage is not null)
{
    <PageTitle>@ShellCopy.UnavailableTitle</PageTitle>
    <ProductUnavailable Message="@UnavailableMessage" RetryHref="@RetryHref" />
}
else if (Theme is { } theme && Entry is { } feature)
{
    <SeoHead Title="@($"{feature.Title} - {theme.DisplayName} Features")" Description="@Description" RelativeUrl="@Links.Absolute(Links.Feature(theme.Key, feature.Slug))" ImageUrl="@KbSeo.Image(theme)" ImageAlt="@theme.DisplayName" />
    <div class="ts-reading">
        <p><a href="@Links.Features(theme.Key)">Features</a></p>
        <article class="ts-kb-article">
            <h1>@feature.Title</h1>
            <p class="ts-kb-meta">@FeatureCopy.Progress(feature.ProgressStatus) · @KbCopy.UpdatedOn(feature.UpdatedAt)</p>
            <KbArticleBody Html="@feature.DescriptionHtml" />
        </article>
        <aside class="ts-kb-help">
            <p><a class="btn btn-primary" href="@Links.RequestFeature(theme.Key)">Request a feature</a></p>
        </aside>
    </div>
}
