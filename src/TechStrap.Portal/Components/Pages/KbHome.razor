@attribute [Route(PortalRoutes.KbHomeTemplate)]
@inherits ProductPageBase

@if (UnavailableMessage is not null)
{
    <PageTitle>@ShellCopy.UnavailableTitle</PageTitle>
    <ProductUnavailable Message="@UnavailableMessage" RetryHref="@RetryHref" />
}
else if (Theme is { } theme && Categories is { } categories)
{
    <SeoHead Title="@SeoText.Title(KbCopy.HomeTitle(theme.DisplayName))" Description="@Description(theme, categories)" RelativeUrl="@Links.Absolute(Links.KbHome(theme.Key))" ImageUrl="@KbSeo.Image(theme)" ImageAlt="@theme.DisplayName" StructuredData="@StructuredData(theme, categories)" />
    <KbBreadcrumbs Crumbs="@Crumbs(theme)" />
    <h1>@KbCopy.HomeHeading</h1>
    <p class="ts-help-intro">@(theme.HelpCenterIntro ?? KbCopy.HomeIntroFallback(theme.DisplayName))</p>
    <KbSearchBox ProductKey="@theme.Key" />
    @if (categories.Count == 0)
    {
        <StateMessage Heading="@KbCopy.EmptyHomeHeading">
            <p>@KbCopy.EmptyHomeText <a href="@Links.Contact(theme.Key)">@KbCopy.ContactUs</a></p>
        </StateMessage>
    }
    else
    {
        <ul class="ts-kb-list ts-kb-list--cards">
            @foreach (var category in categories)
            {
                <li>
                    <article class="ts-kb-card">
                        <h2><a href="@Links.KbCategory(theme.Key, category.Slug)">@category.Name</a></h2>
                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <p class="ts-kb-summary">@category.Description</p>
                        }
                        <p class="ts-kb-meta">@KbCopy.ArticleCount(category.ArticleCount)</p>
                    </article>
                </li>
            }
        </ul>
    }
    @if (Recent is { Count: > 0 })
    {
        <FeaturedArticles ProductKey="@theme.Key" Articles="@Recent" />
    }
}
