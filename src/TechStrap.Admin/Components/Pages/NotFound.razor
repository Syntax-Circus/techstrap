@page "/not-found"
@layout MainLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Not found</PageTitle>
<div class="ts-window-page">
    <BrandWindow Title="ERROR 404 — not found" Heading="This page fell out of its strap.">
        <p>@BrandMomentCopy.NotFoundBody</p>
        <div class="ts-window-action"><a class="ts-window-link" href="/">@BrandMomentCopy.NotFoundLinkText</a></div>
    </BrandWindow>
</div>
