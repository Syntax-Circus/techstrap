@using TechStrap.Contracts.Webhooks
@inject IWebhooksClient Client
@implements IDisposable

<section aria-label="Webhook settings" class="mt-4">
    <h2>@(ProductId is null ? "Global notifications" : "Product webhooks")</h2>
    <p>Post ticket and feature summaries to Discord or a JSON webhook. Messages include an admin link when configured.</p>
    @if (_loading)
    {
        <p role="status">Loading webhooks…</p>
    }
    else if (_settings is null)
    {
        <p role="alert">@_error</p>
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Retry</button>
    }
    else
    {
        @if (_error is not null) { <p class="ts-form-error" role="alert">@_error</p> }
        @if (_message is not null) { <p role="status">@_message</p> }
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <fieldset disabled="@_busy">
                <label class="form-label" for="@($"{_prefix}-mode")">Notification mode</label>
                <select id="@($"{_prefix}-mode")" class="form-select" @bind="_mode">
                    @if (ProductId is not null) { <option value="Inherit">Inherit global destinations and filters</option> }
                    <option value="Replace">@(ProductId is null ? "Use global destinations" : "Use product destinations instead of global")</option>
                    <option value="Disabled">Disable notifications</option>
                </select>
                @if (_mode == "Inherit")
                {
                    <p class="mt-2">Global configuration supplies all destinations and filters.</p>
                    @if (_settings.EffectiveEndpoints.Count == 0) { <p>No global destinations are configured.</p> }
                    @foreach (var endpoint in _settings.EffectiveEndpoints)
                    {
                        <p><strong>@endpoint.Settings.Name</strong> · @endpoint.Settings.Format · @endpoint.Destination · @(endpoint.Settings.Enabled ? "Enabled" : "Disabled")</p>
                        <p>New tickets: @(endpoint.Settings.TicketCreated ? "On" : "Off"); new board entries: @(endpoint.Settings.FeatureCreated ? "On" : "Off"). Ticket types: @string.Join(", ", endpoint.Settings.TicketTypes). Ticket statuses: @Selections(endpoint.Settings.TicketStatuses). Feature statuses: @Selections(endpoint.Settings.FeatureStatuses).</p>
                    }
                }
                @if (_mode == "Replace")
                {
                    @foreach (var draft in _drafts)
                    {
                        <fieldset class="border rounded p-3 mt-3" @key="draft.Key">
                            <legend class="float-none w-auto px-2 fs-6">@draft.Name</legend>
                            <label class="form-label" for="@(draft.Key + "-name")">Name</label>
                            <input id="@(draft.Key + "-name")" class="form-control" maxlength="100" @bind="draft.Name" />
                            <label class="form-label mt-2" for="@(draft.Key + "-format")">Format</label>
                            <select id="@(draft.Key + "-format")" class="form-select" @bind="draft.Format"><option>Discord</option><option value="Json">Generic JSON</option></select>
                            <label class="form-label mt-2" for="@(draft.Key + "-url")">@(draft.Id == Guid.Empty ? "Webhook URL" : "Replace webhook URL (leave blank to keep)")</label>
                            <input id="@(draft.Key + "-url")" type="password" autocomplete="new-password" class="form-control" maxlength="2048" @bind="draft.Url" />
                            @if (draft.Destination is not null) { <p>Saved destination: @draft.Destination</p> }
                            <label class="d-block mt-2"><input type="checkbox" @bind="draft.Enabled" /> Enabled</label>
                            <label class="d-block"><input type="checkbox" @bind="draft.TicketCreated" /> New tickets</label>
                            <label class="d-block"><input type="checkbox" @bind="draft.FeatureCreated" /> New feature-board entries (including drafts)</label>
                            <fieldset class="mt-2"><legend class="fs-6">Ticket types</legend>
                                @foreach (var type in TicketTypes) { <label class="d-block"><input type="checkbox" checked="@draft.TicketTypes.Contains(type)" @onchange="e => Toggle(draft.TicketTypes, type, e)" /> @type</label> }
                            </fieldset>
                            <fieldset class="mt-2"><legend class="fs-6">Also notify when tickets enter</legend>
                                @foreach (var status in TicketStatuses) { <label class="d-block"><input type="checkbox" checked="@draft.TicketStatuses.Contains(status)" @onchange="e => Toggle(draft.TicketStatuses, status, e)" /> @status</label> }
                            </fieldset>
                            <fieldset class="mt-2"><legend class="fs-6">Also notify when features enter</legend>
                                @foreach (var status in FeatureStatuses) { <label class="d-block"><input type="checkbox" checked="@draft.FeatureStatuses.Contains(status)" @onchange="e => Toggle(draft.FeatureStatuses, status, e)" /> @status</label> }
                            </fieldset>
                            <button type="button" class="btn btn-outline-secondary mt-2" @onclick="() => _drafts.Remove(draft)">Remove destination</button>
                            @if (draft.Id != Guid.Empty && draft.Enabled && _settings.Mode == "Replace")
                            {
                                <button type="button" class="btn btn-outline-secondary mt-2" @onclick='() => ActAsync("Test", draft.Id)'>Test saved destination</button>
                            }
                        </fieldset>
                    }
                    <button type="button" class="btn btn-outline-secondary mt-3" disabled="@(_drafts.Count >= 20)" @onclick="Add">Add destination</button>
                }
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save webhooks</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Reload saved settings</button>
                </div>
            </fieldset>
        </form>
        <h3 class="mt-4">Delivery history</h3>
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="RefreshAsync">Refresh deliveries</button>
        @if (_history is { Items.Count: > 0 })
        {
            <div class="table-responsive"><table class="table"><thead><tr><th>Created</th><th>Destination</th><th>Event</th><th>Status</th><th>Attempts</th><th>Details</th><th>Actions</th></tr></thead>
                <tbody>@foreach (var delivery in _history.Items)
                {
                    <tr><td>@delivery.CreatedAt.ToLocalTime().ToString("g")</td><td>@delivery.EndpointName</td><td>@delivery.EventType</td><td>@delivery.Status</td><td>@delivery.Attempts</td><td>@delivery.LastError</td><td>
                        @if (delivery.Status == "DeadLettered") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick='() => ActAsync("Retry", delivery.Id)'>Retry</button> }
                        @if (delivery.Status is "Pending" or "DeadLettered") { <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick='() => ActAsync("Discard", delivery.Id)'>Discard</button> }
                    </td></tr>
                }</tbody>
            </table></div>
        }
        else { <p>No deliveries on this page.</p> }
        <button type="button" class="btn btn-outline-secondary" disabled="@(_busy || _page <= 1)" @onclick="PreviousAsync">Previous</button>
        <span>Page @_page</span>
        <button type="button" class="btn btn-outline-secondary" disabled="@(_busy || _history?.HasMore != true)" @onclick="NextAsync">Next</button>
    }
</section>

@code {
    [Parameter] public Guid? ProductId { get; set; }
    private static readonly string[] TicketTypes = ["Support", "FeatureRequest"];
    private static readonly string[] TicketStatuses = ["New", "Open", "Pending", "Solved", "Closed"];
    private static readonly string[] FeatureStatuses = ["UnderConsideration", "Planned", "InProgress", "Shipped", "NotPlanned"];
    private readonly string _prefix = "webhook-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _lifetime = new();
    private WebhookSettingsDto? _settings;
    private WebhookDeliveryPageDto? _history;
    private List<Draft> _drafts = [];
    private string _mode = "Inherit";
    private string? _error, _message;
    private bool _loading = true, _busy, _disposed;
    private int _page = 1;
    private Guid? _loadedProduct;
    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || ProductId != _loadedProduct) { _initialized = true; _loadedProduct = ProductId; await LoadAsync(); }
    }
    private async Task LoadAsync()
    {
        _loading = true; _error = null; _message = null;
        try
        {
            var result = await Client.GetAsync(ProductId, _lifetime.Token);
            if (result.IsSuccess) Apply(result.Value); else _error = result.Errors[0].Message;
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }
    private void Apply(WebhookSettingsDto settings) { _settings = settings; _mode = settings.Mode; _drafts = settings.Endpoints.Select(x => new Draft(x)).ToList(); }
    private void Add() => _drafts.Add(new Draft(new(new WebhookEndpointRequest(), "")));
    private static void Toggle(HashSet<string> values, string value, ChangeEventArgs e) { if (e.Value is true) values.Add(value); else values.Remove(value); }
    private static string Selections(string[] values) => values.Length == 0 ? "None" : string.Join(", ", values);
    private async Task SaveAsync()
    {
        if (_settings is null || _busy) return;
        _busy = true; _error = null; _message = null;
        try
        {
            var result = await Client.UpdateAsync(ProductId, new(_mode, _settings.Version, _drafts.Select(x => x.Input()).ToArray()), CancellationToken.None);
            if (result.IsSuccess) { Apply(result.Value); _message = "Webhook settings saved."; } else _error = result.Errors[0].Message;
            await RefreshAsync();
        }
        finally { _busy = false; }
    }
    private async Task RefreshAsync()
    {
        if (_disposed) return;
        try { var result = await Client.ListAsync(ProductId, _page, _lifetime.Token); if (result.IsSuccess) _history = result.Value; else _error = result.Errors[0].Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private async Task ActAsync(string action, Guid id)
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null;
        try
        {
            var result = await Client.ActAsync(ProductId, new(action, id), CancellationToken.None);
            if (result.IsSuccess) _message = action == "Test" ? "Test notification queued. Refresh deliveries to check its result." : "Delivery updated.";
            else _error = result.Errors[0].Message;
            await RefreshAsync();
        }
        finally { _busy = false; }
    }
    private async Task PreviousAsync() { if (_page > 1) _page--; await RefreshAsync(); }
    private async Task NextAsync() { _page++; await RefreshAsync(); }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }

    private sealed class Draft(WebhookEndpointDto endpoint)
    {
        internal Guid Key { get; } = Guid.NewGuid();
        internal Guid Id { get; } = endpoint.Settings.Id;
        internal string? Destination { get; } = endpoint.Destination;
        public string Name { get; set; } = endpoint.Settings.Name;
        public string Url { get; set; } = "";
        public string Format { get; set; } = endpoint.Settings.Format;
        public bool Enabled { get; set; } = endpoint.Settings.Enabled;
        public bool TicketCreated { get; set; } = endpoint.Settings.TicketCreated;
        public bool FeatureCreated { get; set; } = endpoint.Settings.FeatureCreated;
        internal HashSet<string> TicketTypes { get; } = endpoint.Settings.TicketTypes.ToHashSet();
        internal HashSet<string> TicketStatuses { get; } = endpoint.Settings.TicketStatuses.ToHashSet();
        internal HashSet<string> FeatureStatuses { get; } = endpoint.Settings.FeatureStatuses.ToHashSet();
        internal WebhookEndpointRequest Input() => new() { Id = Id, Name = Name, Url = string.IsNullOrWhiteSpace(Url) ? null : Url.Trim(), Format = Format, Enabled = Enabled, TicketCreated = TicketCreated, FeatureCreated = FeatureCreated, TicketTypes = TicketTypes.ToArray(), TicketStatuses = TicketStatuses.ToArray(), FeatureStatuses = FeatureStatuses.ToArray() };
    }
}
