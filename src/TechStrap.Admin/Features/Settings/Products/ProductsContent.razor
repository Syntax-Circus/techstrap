<PageTitle>@ProductsCopy.Heading &middot; Settings</PageTitle>
<div class="ts-settings">
    <div class="ts-settings-head">
        <h1>@ProductsCopy.Heading</h1>
        <a class="btn btn-primary" href="/settings/products/new">@ProductsCopy.NewProduct</a>
    </div>

    @if (_loading)
    {
        <LoadingState Rows="4" Label="@ProductsCopy.Loading" />
    }
    else if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_rows.Count == 0)
    {
        <EmptyState Heading="@ProductsCopy.NoProducts">
            <p>@ProductsCopy.NoProductsHint</p>
        </EmptyState>
    }
    else
    {
        <ScrollRegion Label="Products">
            <table role="table" class="table ts-ledger ts-settings-table">
                <thead role="rowgroup">
                    <tr role="row">
                        <th role="columnheader" scope="col">@ProductsCopy.ColumnName</th>
                        <th role="columnheader" scope="col">@ProductsCopy.ColumnKey</th>
                        <th role="columnheader" scope="col">@ProductsCopy.ColumnPrefix</th>
                        <th role="columnheader" scope="col">@ProductsCopy.ColumnPortalHost</th>
                        <th role="columnheader" scope="col">@ProductsCopy.ColumnStatus</th>
                        <th role="columnheader" scope="col"><span class="visually-hidden">@ProductsCopy.ColumnActions</span></th>
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var row in _rows)
                    {
                        <tr role="row" @key="row.Id" data-product="@row.Key">
                            <td role="cell"><a href="/settings/products/@row.Id">@row.Name</a></td>
                            <td role="cell"><code>@row.Key</code></td>
                            <td role="cell"><code>@row.NumberPrefix</code></td>
                            <td role="cell">
                                @if (row.PortalHost is not null)
                                {
                                    <code>@row.PortalHost</code>
                                }
                            </td>
                            <td role="cell"><span class="ts-pill @(row.IsActive ? "ts-pill--on" : "ts-pill--off")">@(row.IsActive ? ProductsCopy.Active : ProductsCopy.Inactive)</span></td>
                            <td role="cell" class="ts-settings-actions">
                                <a href="/settings/products/@row.Id">@ProductsCopy.Edit</a>
                                <a href="/settings/products/@row.Id/keys">@ProductsCopy.ApiKeys</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </ScrollRegion>
    }
</div>
