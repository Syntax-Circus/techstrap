<tr role="row" class="@(Selected ? "ts-row ts-row--selected" : "ts-row")" aria-current="@(Selected ? "true" : null)" data-ticket="@Row.Number">
    <td role="cell" class="ts-col-mark" aria-hidden="true"></td>
    <td role="cell" class="ts-col-number"><a href="@Row.Href">@Row.Number</a></td>
    <td role="cell" class="ts-col-subject">
        <span class="ts-subject">@Row.Subject</span>
        @foreach (var tag in Row.Tags)
        {
            <TagChip Name="@tag.Name" Colour="@tag.Colour" />
        }
    </td>
    <td role="cell" class="ts-col-product" data-label="Product"><span class="ts-product">@Row.ProductName</span></td>
    <td role="cell" class="ts-col-requester" data-label="Requester">@Row.Requester</td>
    <td role="cell" class="ts-col-status"><StatusStamp Status="Row.Stamp" /></td>
    <td role="cell" class="ts-col-priority" data-label="Priority"><PriorityMark Level="Row.Priority" /></td>
    <td role="cell" class="ts-col-assignee" data-label="Assignee">
        @if (Row.AssigneeName is not null)
        {
            <span class="ts-avatar" title="@Row.AssigneeName"><span aria-hidden="true">@Row.AssigneeInitials</span><span class="visually-hidden">@Row.AssigneeName</span></span>
        }
        else
        {
            <span class="ts-unassigned"><span aria-hidden="true">&mdash;</span><span class="visually-hidden">Unassigned</span></span>
        }
    </td>
    <td role="cell" class="ts-col-activity" data-label="Last activity"><RelativeTime When="Row.LastActivity" /></td>
    @if (ShowNotSpam)
    {
        <td role="cell" class="ts-col-actions">
            <button type="button" class="btn btn-link" @onclick="() => OnNotSpam.InvokeAsync(Row)">Not spam <Kbd>u</Kbd></button>
        </td>
    }
</tr>
